# Gramio Environment Variables

# Base URL for the Gramio backend API (no trailing slash).
# Local dev: http://localhost:3000/api
# Production: https://<your-api-host>/api
VITE_OPENSPEAK_API_URL=http://localhost:3000/api

# Public PostHog project key. Leave blank to disable product analytics locally.
VITE_POSTHOG_KEY=
# PostHog ingestion host; use https://eu.i.posthog.com for an EU project.
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Public VAPID key used to subscribe this browser to Gramio reminders.
# Generate the key pair with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# Word database URL (IndexedDB sync source)
# Local testing: http://localhost:3001/words.json
# Production (GitHub raw): https://raw.githubusercontent.com/YOUR_USERNAME/gramio/main/database/words.json
# VITE_DATABASE_URL=http://localhost:3001/words.json
